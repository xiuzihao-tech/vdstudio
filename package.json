{
  "name": "findai-studio",
  "version": "0.1.0",
  "private": true,
  "description": "FIND AI × 大哲 联合视频平台：选题文案 → 生成视频 → 排期发布",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node build.mjs --watch & tsx watch src/server/index.ts",
    "build": "node build.mjs",
    "start": "node --no-warnings=ExperimentalWarning dist/server.js",
    "local": "node scripts/local.mjs",
    "start:env": "node --no-warnings=ExperimentalWarning --env-file=.env dist/server.js",
    "backup": "node --no-warnings deploy/backup.mjs",
    "serve": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "seed:reset": "rm -f data/app.db && echo 数据库已清空，下次启动自动重建"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "playwright": "1.56.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0 || ^6.0.3"
  }
}

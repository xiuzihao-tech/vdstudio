[
  {
    "key": "appId",
    "label": "应用 ID",
    "env": "ALIPAY_APP_ID",
    "required": true
  },
  {
    "key": "privateKey",
    "label": "应用私钥（PEM）",
    "env": "ALIPAY_PRIVATE_KEY",
    "required": true,
    "secret": true,
    "type": "textarea"
  },
  {
    "key": "publicKey",
    "label": "支付宝公钥（PEM）",
    "env": "ALIPAY_PUBLIC_KEY",
    "required": true,
    "type": "textarea"
  },
  {
    "key": "gateway",
    "label": "网关（不填用正式环境）",
    "env": "ALIPAY_GATEWAY"
  }
]

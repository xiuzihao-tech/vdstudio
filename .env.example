# 复制为 .env 后按需填写；不填的服务继续用 Mock。启动：node --env-file=.env dist/server.js

PORT=5173
DATA_DIR=data

# —— 账号 ——
# 1 = 必须登录才能用；不设则允许匿名试用，注册时匿名数据带进账号
AUTH_REQUIRED=0
# 1 = Cookie 只走 HTTPS（上线必须开）
SECURE_COOKIES=0
# 1 = 只能凭邀请码注册（ADMIN_EMAILS 里的邮箱除外）
INVITE_REQUIRED=0
# 管理员邮箱，逗号分隔；用这些邮箱注册的账号能进「后台」
ADMIN_EMAILS=

# —— 成本护栏 ——
# 新账号起步点数
INITIAL_POINTS=1280
# 每个账号每天最多提交几次生成（0 = 不限）
DAILY_JOBS_PER_USER=0
# 全站每天最多花多少点在生成上（0 = 不限），到了自动拒绝新任务
DAILY_BUDGET_POINTS=0
# 每个 IP 每分钟最多多少次写请求
RATE_LIMIT_PER_MIN=120

# —— 合成整条视频（需要 ffmpeg）——
# auto = 有 ffmpeg 就合成；off = 不合成
COMPOSE=auto
# 字幕字体（不填自动找 Noto CJK / 苹方 / 微软雅黑）
SUBTITLE_FONT=

# —— 文案大模型（兼容 OpenAI Chat Completions 的任意服务）——
# OpenLux：     LLM_BASE_URL=https://api.openlux.ai/v1   （模型可在后台「AI 服务」里拉取、切换）
# 豆包（方舟）：LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  LLM_MODEL=<推理接入点 ID 或模型名>
# DeepSeek：    LLM_BASE_URL=https://api.deepseek.com/v1               LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_API_KEY=
# 推荐：默认 deepseek-v4.1-flash；精写 deepseek-v4-pro；备用 deepseek-v4-flash（后台「AI 服务」里也能改，后台的设置优先）
LLM_MODEL=deepseek-v4.1-flash
LLM_MODEL_FINE=deepseek-v4-pro
LLM_FALLBACK_MODELS=deepseek-v4-flash

# —— 视频生成：new-api 类网关的异步视频端点（土豆 API 等）——
# 配了这两项就走它；各档位对应的模型在后台「AI 服务」里改（默认 seedance-2.5 / 2.0 / 2.0-fast / wan3.0）
VIDEO_BASE_URL=
VIDEO_API_KEY=
VIDEO_POLL_MS=8000
# 各档位模型（不填用默认：seedance-2.5 / seedance-2.0 / seedance-2.0-fast / wan3.0，样片 seedance-2.0-mini）
# VIDEO_MODEL_S25= VIDEO_MODEL_S20= VIDEO_MODEL_S20F= VIDEO_MODEL_WAN= VIDEO_MODEL_DRAFT=

# —— （没配 VIDEO_* 时才用） 视频生成：Seedance（火山方舟）——
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL_S25=doubao-seedance-2-5-260628
SEEDANCE_MODEL_S20=doubao-seedance-2-0-260128
SEEDANCE_MODEL_S20F=doubao-seedance-2-0-fast-260128
SEEDANCE_POLL_MS=10000
SEEDANCE_WATERMARK=0

# —— 文件存储（素材、每镜视频、合成好的整条）——
# local = 本机磁盘 DATA_DIR/files；s3 = S3 兼容对象存储（阿里云 OSS / 腾讯云 COS / AWS / MinIO）
STORAGE=local
# 阿里云 OSS 例：S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com  S3_REGION=oss-cn-hangzhou
# 腾讯云 COS 例：S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com S3_REGION=ap-guangzhou  S3_BUCKET=<桶名-APPID>
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 桶里统一加的目录前缀（比如 prod），可不填
S3_PREFIX=
# 配了 CDN 就填 CDN 域名（桶要能被 CDN 回源读取）；不填则用 10 分钟有效的签名链接
S3_PUBLIC_BASE_URL=
# MinIO 等需要路径风格时设 1
S3_FORCE_PATH_STYLE=0

# —— 首帧素材给视频服务取用 ——
# 本服务的公网地址；设了就把素材图的签名链接（2 小时有效）作为首帧发给视频服务。
# 不设（本机运行）时自动改成把图片内联成 Base64 发过去；用了对象存储则直接给桶的签名链接
PUBLIC_BASE_URL=
# 签名密钥，多实例部署时必须一致；不设则每次启动随机生成
FILE_SIGN_SECRET=

# —— 上线 / 部署 ——
# NODE_ENV=production 时启动会自检：缺 SECURE_COOKIES=1、FILE_SIGN_SECRET（≥32 位）、ADMIN_EMAILS 就拒绝启动（Docker 镜像里已设好）
# 前后端分开部署时：允许调用后端的前端域名（逗号分隔，不能写 *），并把 COOKIE_SAMESITE 设为 None
CORS_ORIGINS=
COOKIE_SAMESITE=Lax
# 每个请求打一行 JSON 访问日志（生产环境默认开）
# LOG_REQUESTS=1
# 在反向代理（Caddy / Nginx / 负载均衡）后面时信任 X-Forwarded-For 取真实 IP（生产环境默认开）
# TRUST_PROXY=1

# 强制全部用 Mock（测试用）
# AI_PROVIDER=mock
